# Скопируйте в .env (это делает scripts/setup_clients.py) и заполните. .env НЕ коммитить.

# ---------- IACPaaS ----------
IACPAAS_BACKEND=mock                 # mock — песочница (fixtures/), http — реальная платформа
IACPAAS_URL=https://iacpaas.dvo.ru
# Вход — одно из трёх:
IACPAAS_API_KEY=                     # ключ от администратора платформы (заголовок X-API-KEY)
IACPAAS_JWT=                         # готовый JWT
IACPAAS_USERNAME=                    # или логин/пароль: JWT получается через /api/signin и обновляется сам
IACPAAS_PASSWORD=

# ---------- Запись (только в свою папку, с подтверждением) ----------
IACPAAS_ALLOW_WRITE=false            # true — появляются изменяющие инструменты (с mock — в песочнице)
IACPAAS_REMOTE_WRITE=false           # true — разрешить запись на РЕАЛЬНУЮ платформу (нужны оба флага)
IACPAAS_WRITE_PATHS=                 # папки, куда можно писать на платформе (через «;»); пусто – запись на платформу выключена
IACPAAS_CONFIRM_TTL=300              # сколько секунд живёт токен подтверждения
IACPAAS_PIECES=text                  # ответ gas_query: text – модель пересказывает дословно (VS Code); marks – метки для нашего агента

# ---------- Лимиты ----------
IACPAAS_TIMEOUT=60                   # платформа обрабатывает запрос до 30 с
IACPAAS_RETRIES=2                    # повторы только для чтения и только при временных сбоях
IACPAAS_MAX_CONCURRENCY=2
IACPAAS_CACHE_TTL=0                  # 0 – данные с платформы при каждом запросе (без кэша)
IACPAAS_MAX_DEPTH=6
IACPAAS_MAX_NODES=400
IACPAAS_MAX_RESULT_CHARS=60000

# ---------- MCP-сервер (HTTP-режим) ----------
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_BEARER_TOKEN=                    # общий секрет агента и сервера, не короче 16 символов

# ---------- Логи ----------
LOG_LEVEL=INFO
LOG_FILE=logs/server.jsonl

# ---------- Агент ----------
AGENT_MODEL=auto                     # профиль из config/models.toml или auto (первый доступный)
AGENT_MCP=stdio                      # stdio — сервер запускается сам; http — к запущенному; inproc — в процессе
MCP_URL=http://127.0.0.1:8765/mcp
AGENT_MAX_TOOL_CALLS=15
AGENT_MAX_MODEL_CALLS=25
AGENT_KEEP_MESSAGES=15              # сколько сообщений прошлых вопросов видит модель (их данные – заглушками)
AGENT_TRACE=logs/agent_trace.jsonl
AGENT_DB=data/agent.sqlite
WEB_PORT=8770
WEB_TOKEN=                           # необязательный токен веб-чата

# ---------- Ключи моделей (нужные заполнить) ----------
GIGACHAT_CREDENTIALS=
GIGACHAT_CA_BUNDLE_FILE=certs/russian_trusted_root_ca.cer
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# Если в системе прописан прокси/VPN: локальные адреса не должны идти через него
NO_PROXY=localhost,127.0.0.1
